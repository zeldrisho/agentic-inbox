{
  "name": "agentic-inbox",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "vp exec react-router build",
    "cf-typegen": "vp exec wrangler types",
    "deploy": "vp run build && vp exec wrangler deploy",
    "test:e2e": "vp exec playwright test",
    "dev": "vp exec react-router dev",
    "preview": "vp run build && vp preview",
    "typecheck": "vp run cf-typegen && vp exec react-router typegen && tsc -b",
    "prepare": "vp config"
  },
  "dependencies": {
    "@cloudflare/ai-chat": "^0.12.0",
    "@cloudflare/kumo": "^2.13.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.102.8",
    "@tiptap/extension-color": "3.31.3",
    "@tiptap/extension-highlight": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/extension-underline": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "agents": "^0.23.0",
    "ai": "^7.0.100",
    "dompurify": "^3.4.15",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "isbot": "^5.2.2",
    "jose": "^6.2.12",
    "postal-mime": "^3.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.1",
    "remark-gfm": "^4.0.1",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@ai-sdk/react": "^4.0.103",
    "@cloudflare/vite-plugin": "^1.54.9",
    "@cloudflare/workers-types": "^5.20260915.1",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.3.1",
    "@shadcn/lint": "^0.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "catalog:",
    "wrangler": "^4.131.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    }
  },
  "cloudflare": {
    "label": "Agentic Inbox",
    "products": [
      "Workers",
      "Durable Objects",
      "R2",
      "Workers AI"
    ],
    "bindings": {
      "DOMAINS": {
        "description": "Your domain with [Email Routing](https://developers.cloudflare.com/email-routing/) enabled (e.g. `example.com`). After deploying, create a catch-all Email Routing rule pointing to this Worker."
      }
    }
  }
}
